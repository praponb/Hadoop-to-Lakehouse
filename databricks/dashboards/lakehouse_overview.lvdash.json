{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Sales KPIs",
      "queryLines": [
        "SELECT\n",
        "  SUM(net_revenue) AS net_revenue,\n",
        "  SUM(total_orders) AS total_orders,\n",
        "  SUM(cancellation_rate * total_orders) / SUM(total_orders) AS cancellation_rate,\n",
        "  (SELECT COUNT(*) FROM legacy_migration_cat.gold.customer_ltv) AS customers\n",
        "FROM legacy_migration_cat.gold.daily_sales_summary"
      ]
    },
    {
      "name": "daily_totals",
      "displayName": "Daily totals",
      "queryLines": [
        "SELECT\n",
        "  order_date,\n",
        "  SUM(net_revenue) AS net_revenue,\n",
        "  SUM(total_orders) AS total_orders,\n",
        "  SUM(cancellation_rate * total_orders) / SUM(total_orders) AS cancellation_rate\n",
        "FROM legacy_migration_cat.gold.daily_sales_summary\n",
        "GROUP BY order_date"
      ]
    },
    {
      "name": "top_skus",
      "displayName": "Top SKUs",
      "queryLines": [
        "SELECT product_sku, SUM(net_revenue) AS net_revenue\n",
        "FROM legacy_migration_cat.gold.daily_sales_summary\n",
        "GROUP BY product_sku\n",
        "ORDER BY net_revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ltv_bands",
      "displayName": "Customer spend bands",
      "queryLines": [
        "SELECT band, sort_key, COUNT(*) AS customers\n",
        "FROM (\n",
        "  SELECT\n",
        "    CASE WHEN lifetime_spend < 2500 THEN 'Under 2.5k'\n",
        "         WHEN lifetime_spend < 5000 THEN '2.5k-5k'\n",
        "         WHEN lifetime_spend < 10000 THEN '5k-10k'\n",
        "         WHEN lifetime_spend < 15000 THEN '10k-15k'\n",
        "         ELSE '15k and over' END AS band,\n",
        "    CASE WHEN lifetime_spend < 2500 THEN 1\n",
        "         WHEN lifetime_spend < 5000 THEN 2\n",
        "         WHEN lifetime_spend < 10000 THEN 3\n",
        "         WHEN lifetime_spend < 15000 THEN 4\n",
        "         ELSE 5 END AS sort_key\n",
        "  FROM legacy_migration_cat.gold.customer_ltv\n",
        ")\n",
        "GROUP BY band, sort_key"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "Top customers",
      "queryLines": [
        "SELECT customer_id, lifetime_spend, lifetime_orders\n",
        "FROM legacy_migration_cat.gold.customer_ltv\n",
        "ORDER BY lifetime_spend DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "quality_kpis",
      "displayName": "Quality KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT COUNT(*) FROM legacy_migration_cat.bronze.orders_raw) AS bronze_rows,\n",
        "  (SELECT COUNT(*) FROM legacy_migration_cat.silver.orders_cleansed) AS silver_rows,\n",
        "  (SELECT COUNT(*) FROM legacy_migration_cat.silver.orders_quarantine) AS quarantine_rows,\n",
        "  (SELECT COUNT(*) FROM legacy_migration_cat.silver.orders_quarantine) / (SELECT COUNT(*) FROM legacy_migration_cat.bronze.orders_raw) AS quarantine_rate"
      ]
    },
    {
      "name": "batch_rows",
      "displayName": "Rows per batch",
      "queryLines": [
        "SELECT batch_date, stage, rows FROM (\n",
        "  SELECT batch_date, '1 Bronze' AS stage, COUNT(*) AS rows FROM legacy_migration_cat.bronze.orders_raw GROUP BY batch_date\n",
        "  UNION ALL\n",
        "  SELECT _batch_date, '2 Silver', COUNT(*) FROM legacy_migration_cat.silver.orders_cleansed GROUP BY _batch_date\n",
        "  UNION ALL\n",
        "  SELECT batch_date, '3 Quarantine', COUNT(*) FROM legacy_migration_cat.silver.orders_quarantine GROUP BY batch_date\n",
        ")"
      ]
    },
    {
      "name": "quarantine_reasons",
      "displayName": "Quarantine reasons",
      "queryLines": [
        "SELECT reason, COUNT(*) AS rows\n",
        "FROM legacy_migration_cat.silver.orders_quarantine\n",
        "LATERAL VIEW explode(split(error_reason, '; ')) r AS reason\n",
        "GROUP BY reason"
      ]
    }
  ],
