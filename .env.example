# Google Cloud Platform
GCP_PROJECT_ID=moukda-lakehouse
GCP_REGION=asia-southeast1
GCS_LANDING_BUCKET=gs://moukda-lakehouse-landing
GCS_LAKEHOUSE_BUCKET=gs://moukda-lakehouse-uc
# Path inside the Airflow containers (./config is mounted at /opt/airflow/config)
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/config/gcp-service-account.json

# Hadoop HDFS (Local Docker Container)
HDFS_NAMENODE_HOST=namenode
HDFS_WEBHDFS_PORT=9870
HDFS_SOURCE_PATH=/legacy/erp/orders

# Databricks on GCP
DATABRICKS_HOST=https://<your-workspace-id>.gcp.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=legacy_migration_cat
# Jobs run on serverless compute (no cluster ID). The audit task queries this SQL Warehouse:
# SQL Warehouses > <warehouse> > Overview, the ID in "Name (ID: ...)" or the end of the HTTP path
DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
# Job id of the deployed bundle job, which the DAG triggers (`databricks bundle summary` shows its URL)
DATABRICKS_JOB_ID=000000000000000

# BigQuery
BQ_DATASET=lakehouse_gold
BQ_CONNECTION=biglake_gcs

# Local Airflow
AIRFLOW_UID=50000
